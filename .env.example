# Public Supabase browser configuration. The publishable key is designed for client use.
SUPABASE_URL=PASTE_YOUR_SUPABASE_URL
SUPABASE_PUBLISHABLE_KEY=PASTE_YOUR_SUPABASE_PUBLISHABLE_KEY

# Server-only secrets. Never expose these in frontend JavaScript.
UNSPLASH_ACCESS_KEY=PASTE_YOUR_UNSPLASH_ACCESS_KEY
OPENROUTER_API_KEY=PASTE_YOUR_OPENROUTER_API_KEY
# Optional: pick the AI model (default openai/gpt-4o-mini)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Public site URL used by the sitemap and robots routes (no trailing slash).
SITE_URL=https://YOUR-DOMAIN.example

# Affiliate earning. Both are public identifiers, not secrets: they appear in the links on the
# page. Leave AFFILIATE_BOOKING_AID empty and no booking button is shown anywhere.
# Get the aid from your Booking.com affiliate account, then add it in Vercel and redeploy.
AFFILIATE_BOOKING_AID=
# Optional button wording (default: Find a place to stay)
AFFILIATE_BOOKING_LABEL=
